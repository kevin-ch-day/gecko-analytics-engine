# Copy this file to `.env` for local development.
# `.env` is local and should not be committed.

# Local XAMPP MariaDB/MySQL defaults.
GECKO_DB_HOST=localhost
GECKO_DB_PORT=3306
GECKO_DB_NAME=gecko_research_database_prod
GECKO_DB_USER=root
GECKO_DB_PASSWORD=

GECKO_OUTPUT_ROOT=output
GECKO_DATA_ROOT=data
GECKO_LOG_LEVEL=INFO
